{
  "version": "1.0",
  "nodes": [
    {
      "id": "fetch1",
      "label": "Fetch CSV",
      "type": "fetch",
      "uri": "http://localhost:18091/products.csv",
      "mime_type": "text/csv",
      "description": "Get CSV from local data server"
    },
    {
      "id": "convert1",
      "label": "Convert to JSON",
      "type": "command",
      "command_type": "converttojson",
      "input": "fetch1",
      "schema_uri": "http://localhost:18090/public-products.json",
      "description": "Convert CSV to JSON table"
    },
    {
      "id": "render_table1",
      "label": "Render Table HTML",
      "type": "command",
      "command_type": "render",
      "input": "convert1",
      "mime_type": "text/html",
      "description": "Generate HTML table",
      "meta": {"title": "Products Table"}
    }
  ],
  "outputs": [
    {"id": "main_view", "label": "CSV View", "source": "render_table1", "description": "Main CSV view"}
  ]
}
