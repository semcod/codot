{
  "bundle": "weather-europe-view",
  "kind": "VIEW_BUNDLE",
  "version": "1.0.0",
  "description": "Live weather dashboard for Europe (Berlin, Paris, Rome, Warsaw) from Open-Meteo",
  "schema_uri": "https://example.com/bundle.schema.json",
  "runner": "go_temporal",
  "sources": [
    {
      "name": "weather-berlin",
      "uri": "https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&current_weather=true",
      "refresh_sec": 300,
      "type": "http_get"
    },
    {
      "name": "weather-paris",
      "uri": "https://api.open-meteo.com/v1/forecast?latitude=48.85&longitude=2.35&current_weather=true",
      "refresh_sec": 300,
      "type": "http_get"
    },
    {
      "name": "weather-rome",
      "uri": "https://api.open-meteo.com/v1/forecast?latitude=41.90&longitude=12.50&current_weather=true",
      "refresh_sec": 300,
      "type": "http_get"
    },
    {
      "name": "weather-warsaw",
      "uri": "https://api.open-meteo.com/v1/forecast?latitude=52.23&longitude=21.01&current_weather=true",
      "refresh_sec": 300,
      "type": "http_get"
    }
  ],
  "template": {
    "engine": "jinja2",
    "source_uri": "file:///templates/weather-dashboard.html"
  },
  "output": {
    "format": "html",
    "runtime": {
      "port": 8082,
      "lang": "php"
    }
  }
}
