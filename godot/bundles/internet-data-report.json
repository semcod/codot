{
  "bundle": "internet-data-report",
  "kind": "VIEW_BUNDLE",
  "version": "1.0.0",
  "description": "Combined weather + currency report fetched from public internet APIs",
  "schema_uri": "https://example.com/bundle.schema.json",
  "runner": "go_temporal",
  "sources": [
    {
      "name": "weather-berlin",
      "uri": "https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&current_weather=true",
      "refresh_sec": 600,
      "type": "http_get"
    },
    {
      "name": "nbp-rates",
      "uri": "https://api.nbp.pl/api/exchangerates/tables/A/?format=json",
      "refresh_sec": 3600,
      "type": "http_get",
      "depends_on": ["weather-berlin"]
    }
  ],
  "template": {
    "engine": "jinja2",
    "source_uri": "file:///templates/internet-report.html"
  },
  "output": {
    "format": "report",
    "runtime": {
      "port": 8082,
      "lang": "php"
    }
  }
}
