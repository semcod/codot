{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public-posts.json",
  "title": "Posts",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "author"],
    "properties": {
      "id":     { "type": "integer" },
      "title":  { "type": "string", "minLength": 1 },
      "author": { "type": "string" },
      "tags":   { "type": "array", "items": { "type": "string" } }
    }
  }
}
