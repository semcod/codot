{
  "kind": "VIEW_BUNDLE",
  "bundle": "protocol-dashboard",
  "version": "1.0.0",
  "description": "Live protocol dashboard aggregating device and protocol data",
  "sources": [
    {
      "name": "protocol",
      "uri": "http://localhost:8080/api/v3/protocols/123",
      "refresh": "1s",
      "method": "GET"
    },
    {
      "name": "devices",
      "uri": "http://localhost:8081/api/v3/devices",
      "refresh": "5s",
      "depends_on": ["protocol"],
      "method": "GET"
    }
  ],
  "template": {
    "engine": "jinja2",
    "source_uri": "file:///templates/dashboard.html"
  },
  "transport": "polling",
  "exposure": {
    "port": 8082,
    "health_path": "/health"
  }
}
